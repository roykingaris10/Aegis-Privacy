# Copy to .env.local and fill in your values. .env.local is gitignored.
# .env.local overrides .env for secrets.

# Local SQLite for dev (committed in .env; override here for Postgres etc).
DATABASE_URL="file:./dev.db"

# Required in Sprint 2b and beyond: Anthropic API key.
# Get one at https://console.anthropic.com, set up billing, and paste here.
# Without this, /api/coach/* endpoints return a friendly "Coach is offline"
# error and the Sprint 2a stubs fall back in.
ANTHROPIC_API_KEY=

# NextAuth (Sprint 3a). AUTH_URL + AUTH_SECRET live in .env with dev
# defaults; override only if you need to.
# AUTH_URL=http://localhost:3000
# AUTH_SECRET=

# Resend (optional — if unset, magic links log to the dev console
# instead of being emailed). Get a key at https://resend.com.
RESEND_API_KEY=

# From-address for Resend. Defaults to Resend's shared onboarding@resend.dev
# if unset, which only works for verified recipients. Set this to an
# address on a verified domain for production.
# AUTH_FROM_EMAIL="Aegis <hello@yourdomain.com>"
