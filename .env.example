# Copy to .env.local and fill in your values. .env.local is gitignored.
# .env.local overrides .env for secrets.

# Local SQLite for dev (committed in .env; override here for Postgres etc).
DATABASE_URL="file:./dev.db"

# Required in Sprint 2b and beyond: Anthropic API key.
# Get one at https://console.anthropic.com, set up billing, and paste here.
# Without this, /api/coach/* endpoints return a friendly "Coach is offline"
# error and the Sprint 2a stubs fall back in.
ANTHROPIC_API_KEY=
